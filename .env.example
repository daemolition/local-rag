# Beispiel-Environment für Docker-Deployment
# Kopiere diese Datei zu .env und passe die Werte an

# === LLM Settings ===
MODEL=granite3.2-vision:2b-q8_0
BASEURL=http://vllm:11434/v1
TEMPERATURE=0.1
TOP_P=0.2
API_KEY=loc-123

# === Embedding Settings ===
EMBEDDING_SOURCE=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_ENDPOINT=http://vllm:8080/v1
EMBEDDING_DIMENSION=384

# === Retriever Settings ===
RETRIEVER_K=5
RETRIEVER_FETCH_K=30
RETRIEVER_LAMBDA=0.5
RETRIEVER_SCORE_THRESHOLD=0.2

# === Storage Settings ===
DATA_DIR=./data
SUMMARIES_DIR=./summaries

# === Qdrant Settings ===
# QDRANT_LOCAL=true  -> Lokale .db Datei (Default für lokale Entwicklung)
# QDRANT_LOCAL=false -> Remote Qdrant Server (Docker)
QDRANT_LOCAL=false
QDRANT_HOST=qdrant
QDRANT_PORT=6333
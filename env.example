# =============================================================================
# WICHTIG: App-Konfiguration (LLM, Embedding, Retriever, Storage) wird im
# Admin-Panel (UI / Settings-DB) gepflegt - NICHT mehr hier in der env.
# Diese env enthaelt nur noch Secrets, Qdrant-Infra und Nicht-UI-Vars.
# =============================================================================

# API Key (use "ollama" for local Ollama, or your actual key for remote services)
API_KEY=ollama

# Qdrant (connect to a running Qdrant server; in docker-compose default: "qdrant")
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_API_KEY=secret  # only for secured remote Qdrant

# OCR paths (Windows only - set to your Tesseract/Poppler installation)
POPPLER_PATH="C:/poppler/Library/bin"
TESSERACT_PATH="C:/Program Files (x86)/Tesseract-OCR"
TESSERACT_CMD="C:/Program Files (x86)/Tesseract-OCR/tesseract.exe"

# Default admin/user passwords (change in production!)
ADMIN_PASSWORD=admin
USER_PASSWORD=user
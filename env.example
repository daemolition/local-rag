# =============================================================================
# WICHTIG: Auflösungsreihenfolge ist Datenbank First - Env - Default.
# App-Konfiguration (LLM, Embedding, Retriever, Storage, STT, API_KEYs) wird im
# Einstellungen-Panel (UI / Settings-DB) gepflegt. Sobald ein Setting einmal in
# der DB existiert, gewinnt der DB-Wert dauerhaft gegen diese env-Datei - ein
# Aendern hier hat dann keinen Effekt mehr, bis der Wert ueber das UI geaendert
# wird. Diese env greift nur beim allerersten Erstellen der Settings-Zeilen
# (frische DB) und enthaelt sonst nur noch Qdrant-Infra und OCR-Pfade.
# =============================================================================

# Qdrant (connect to a running Qdrant server; in docker-compose default: "qdrant")
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_API_KEY=secret  # only for secured remote Qdrant

# OCR paths (Windows only - set to your Tesseract/Poppler installation)
POPPLER_PATH="C:/poppler/Library/bin"
TESSERACT_PATH="C:/Program Files (x86)/Tesseract-OCR"
TESSERACT_CMD="C:/Program Files (x86)/Tesseract-OCR/tesseract.exe"
